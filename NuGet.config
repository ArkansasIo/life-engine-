<configuration>
  <!--
    NuGet configuration for LifeEngine.

    System.Resources.Extensions is packaged as netstandard2.0, which NuGet does
    not consider compatible with net45, so restore fails with NU1202. The
    PackageSourceMapping section below is combined with the AssetTargetFallback
    property in LifeEngine.csproj to let that one package resolve on net45: it
    is in fact built against .NET Framework 4.5 and ships a working net45 asset,
    and the Windows Forms resource writer requires it for the form's icon.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.NETFramework.ReferenceAssemblies" />
      <package pattern="System.Resources.Extensions" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

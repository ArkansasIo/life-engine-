<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LifeEngine is a Windows Forms application on .NET Framework 4.5.

    This is an SDK-style project, which is what C# Dev Kit and modern tooling
    expect. Unlike the old-style project this replaces, the compiler is handed
    the whole directory rather than a hand-maintained list, so a new .cs file
    under Sources/ is picked up without editing this file. The Files list is
    kept readable rather than exhaustive.

    Building needs either the .NET Framework 4.5 targeting pack, or
    Microsoft.NETFramework.ReferenceAssemblies, which supplies the reference
    assemblies for .NET Framework on any machine. Run:

      dotnet build Sources/LifeEngine.csproj -c Release

    Windows only: WinForms on .NET Framework does not build elsewhere.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net45</TargetFramework>
    <RootNamespace>LifeEngine</RootNamespace>
    <AssemblyName>LifeEngine</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <LangVersion>7.3</LangVersion>

    <!--
      The generated .resx files are switched off. FormLife.resx held the form's
      icon and Resources.resx held three bitmaps; the SDK resource writer
      serialises those in a format the .NET Framework runtime cannot read
      without a binding redirect for System.Resources.Extensions, which the SDK
      does not generate. The program therefore crashed the first time a menu
      asked for an icon.

      The icons are embedded as raw PNGs instead and read by name in
      Properties\Resources.Designer.cs, and the form's icon comes from Icon.ico
      through the ApplicationIcon property above. Both routes the runtime can
      read natively, so System.Resources.Extensions is not needed at all and the
      NU1701 warning that went with it is gone.
    -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <NoWarn>$(NoWarn);CS1591;IDE0044;IDE0005</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>..\Binaries\Debug\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>3</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\Binaries\Release\</OutputPath>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The reference assemblies for .NET Framework 4.5, so the project builds on
      a machine that has the runtime but not the targeting pack.
    -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Deployment" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The menu icons, embedded so Properties\Resources.Designer.cs can find
      them by name. LogicalName pins each one to a flat name under the
      LifeEngine.Resources namespace, because the SDK would otherwise fold the
      folder into the name.
    -->
    <EmbeddedResource Include="Resources\IconColor.png">
      <LogicalName>LifeEngine.Resources.IconColor.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\IconGrid.png">
      <LogicalName>LifeEngine.Resources.IconGrid.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\IconHelp.png">
      <LogicalName>LifeEngine.Resources.IconHelp.png</LogicalName>
    </EmbeddedResource>

    <!--
      The application icon. ApplicationIcon above is what Explorer and the task
      bar use; this is the copy FormLife's designer reads through
      Icon.ExtractAssociatedIcon when it needs an Image for the title bar.
    -->
    <None Update="Icon.ico" />
  </ItemGroup>

</Project>
